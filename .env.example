# Server Configuration
WS_PORT=8080
STATUS_WS_PORT=8081
API_PORT=3600
NODE_ENV=development

# Logging Configuration
LOG_LEVEL=info
LOG_TO_FILE=false

# Loki Configuration (опционально)
# Раскомментируйте для включения отправки логов в Loki
# LOKI_URL=http://localhost:3100
# LOKI_USERNAME=
# LOKI_PASSWORD=

# Server identification for Loki labels
SERVER_NAME=main

# Database
DB_PATH=./data/devices.db

# CORS and Security
TRUST_PROXY=1
